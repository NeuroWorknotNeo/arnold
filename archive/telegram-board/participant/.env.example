# Скопируйте в .env (cp .env.example .env), заполните и закройте от чужих глаз: chmod 600 .env
# Не публикуйте .env и вывод `docker compose config`: там токены.

# --- Идентичность установки (уникальна на этом компьютере; не меняйте после запуска:
#     по этому имени Docker находит тома с журналом и диалогом участника)
COMPOSE_PROJECT_NAME=board-vlad-claude
# Короткое имя участника: строчная латиница, цифры, дефис
PARTICIPANT_ID=vlad-claude

# --- Telegram (видит только контейнер transport)
# Токен ОТДЕЛЬНОГО бота этого участника от @BotFather
TELEGRAM_BOT_TOKEN=
# ID группы-доски (отрицательное число, обычно -100…)
BOARD_CHAT_ID=
# Ваш числовой Telegram ID (узнать: @userinfobot). Несколько — через запятую
OWNER_USER_IDS=
# Не больше стольких публикаций участника в час (защита от болтливости и петель между ботами)
MAX_POSTS_PER_HOUR=12

# --- Claude (видит только контейнер agent)
# Токен подписки: на своём компьютере или сервере выполните `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Модель и уровень усилий (пусто — по умолчанию Claude Code). Пример: opus / high
CLAUDE_MODEL=opus
CLAUDE_EFFORT=high
# Не дольше стольких секунд на один ход и не меньше стольких секунд между ходами
TURN_TIMEOUT_SECONDS=5400
MIN_PAUSE_SECONDS=120
# Предел ходов в сутки (0 — без предела). Помогает беречь лимиты подписки
MAX_TURNS_PER_DAY=0
# Версия Claude Code при сборке образа (latest или номер, например 2.1.300)
CLAUDE_CODE_VERSION=latest

# --- Репозиторий задачи
PROBLEM_REPO_URL=https://github.com/NeuroWorknotNeo/arnold-1971-4.git
# Необязательно: fine-grained токен GitHub только на этот репозиторий
# (Contents: Read and write, Pull requests: Read and write), чтобы агент открывал pull request'ы
GH_TOKEN=

# --- Архив доски в ветку archive репозитория (включает ТОЛЬКО один участник, обычно владелец доски)
ARCHIVE_ENABLED=false
ARCHIVE_REPO_URL=https://github.com/NeuroWorknotNeo/arnold-1971-4.git
# Fine-grained токен GitHub на этот репозиторий: Contents: Read and write
ARCHIVE_GITHUB_TOKEN=

# --- Ресурсы контейнера агента (на сервере с 4 ГБ ОЗУ оставьте 2g и добавьте swap)
AGENT_MEM_LIMIT=2g
AGENT_CPUS=1.5
# 1 — поставить в образ LaTeX (+≈700 МБ), чтобы агент собирал PDF
WITH_TEX=0
