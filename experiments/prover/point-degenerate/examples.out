P1 :  U = x**4 + x**3*z**2 + x*z**6 + y**4 + 2*y**3*z**2 + 3*y*z**6 - z**6
  m = 4, u_m = x**4 + y**4;  p(y1,y2) = u_m(y1,y2,1) = b1**4 + b2**4
