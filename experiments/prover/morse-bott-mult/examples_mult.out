W2 :  U = x**6 + y*z**5 + z**4 + z*(-x**4 + 6*x**2*y**2 - y**4 + 6*(x**2 + y**2)**2 + (x**2 + y**2)*(4*x**2 - 4*y**2))
  носитель S и коэффициенты phi_il(theta):
     (0, 4) : 1
     (1, 1) : 9 - 8*sin(t)**4
     (2, 0) : cos(t)**6
     (2, 5) : sin(t)
  gamma* = 1/3 , N = 3 , j = m + 2r gamma* = 16/3 , c = 1 + gamma* = 4/3
