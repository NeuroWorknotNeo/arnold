  носитель S и коэффициенты phi_il(theta):
     (0, 4) : 1
     (1, 3) : -2*sin(2*t)
     (2, 0) : sin(t)**2
     (2, 2) : 3/4 - 3*cos(4*t)/4
     (2, 3) : -4*cos(t)**3
     (3, 0) : cos(t)**7
     (3, 1) : -4*sin(t)**3*cos(t)**3
     (3, 2) : 12*sin(t)*cos(t)**4
     (4, 0) : sin(t)**4*cos(t)**4
     (4, 1) : -12*sin(t)**2*cos(t)**5
     (4, 2) : 6*cos(t)**6
     (5, 0) : 4*sin(t)**3*cos(t)**6
     (5, 1) : -12*sin(t)*cos(t)**7
     (6, 0) : 6*sin(t)**2*cos(t)**8
     (6, 1) : -4*cos(t)**9
     (7, 0) : 4*sin(t)*cos(t)**10
     (8, 0) : cos(t)**12
  gamma* = 1/2 , N = 2 , j = m + 2r gamma* = 6 , c = 1 + gamma* = 3/2
  Phi_0(theta, eps) = epsilon**4 + sin(t)**2
  U~(sigma,theta,eps) = epsilon**4 - 4*epsilon**3*sigma**3*cos(t)**3 - 2*epsilon**3*sigma*sin(2*t) + 6*epsilon**2*sigma**6*cos(t)**6 + 12*epsilon**2*sigma**4*sin(t)*cos(t)**4 - 3*epsilon**2*sigma**2*cos(4*t)/4 + 3*epsilon**2*sigma**2/4 - 4*epsilon*sigma**9*cos(t)**9 - 12*epsilon*sigma**7*sin(t)*cos(t)**7 - 12*epsilon*sigma**5*sin(t)**2*cos(t)**5 - 4*epsilon*sigma**3*sin(t)**3*cos(t)**3 + sigma**12*cos(t)**12 + 4*sigma**10*sin(t)*cos(t)**10 + 6*sigma**8*sin(t)**2*cos(t)**8 + 4*sigma**6*sin(t)**3*cos(t)**6 + sigma**4*sin(t)**4*cos(t)**4 + sigma**2*cos(t)**7 + sin(t)**2
  тождество U(s omega + s^c eps n) = s^j U~(s^(1/N),theta,eps): True
  U~ - (eps - eps*)^4 = sigma**2*cos(t)**7 + sin(t)**2   => точная ветвь кратности 3 при всех sigma, M == 1
  Ghat(sigma,theta) = U~(sigma,theta,eps*) = sin^2 t + sigma^2 cos^7 t: True
  f(sigma,tau) = Ghat(sigma, pi + tau) = -sigma**2*cos(tau)**7 + sin(tau)**2
  d_tau f = (7*sigma**2*cos(tau)**5 + 2)*sin(tau)*cos(tau)  => полярная кривая tau = 0 (около 0), f(sigma,0) = -sigma**2
  sigma^-2 f(sigma, sigma b) ->  b**2 - 1   (Q_V = b^2, a = 1, Gamma_1 = 2, A' = 1)
