==============================================================================
E1 ничья симметричная | две глобальные ветви +-t/sqrt2 с равной глубиной; вторая в окне при b=-sqrt2
f = s**3 - s*tau**2 + tau**4
  d_tau f(t^N1, T(t)) = 0
  Gamma1 = 4  a = 1/4  nu_k = {2: 2, 3: 1, 4: 0}  A'* = 1  K* = [2, 3, 4]
  Q_V(b) = b**4 + 2*sqrt(2)*b**3 + 2*b**2  = b**2*(b**2 + 2*sqrt(2)*b + 2)
  alpha = 1/2  gamma = 2
  min Q_V на R = 0.0  k0 = 2  c_k0 = 2
  t         |tau_v - T(t)|      f(s,tau_v)/(-a t^G1)   sup_{|b|<=1.2}|prof - (-a+Q_V)|
  1e-2              0.0               0.9996         0.0001   (ничьих: 2)
  1e-3              0.0             0.999996         1.0e-6   (ничьих: 2)
  1e-4              0.0           0.99999996         1.0e-8   (ничьих: 2)
  1e-6       7.4184e-68       0.999999999996        1.0e-12   (ничьих: 2)
  1e-8              0.0                  1.0        1.0e-16   (ничьих: 2)
  min_{|b|<=0.3} [(1+alpha) b Q_V' - Q_V] = 0.0
